{
  "name": "sparo",
  "version": "0.1.0",
  "private": true,
  "description": "Sparo Agent Browser — The browser built for AI agents — humans stay in control. Sparo 人机同窗浏览器 — AI 驾驭网页，你驾驭 AI.",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "start": "electron-vite dev",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 50",
    "test": "vitest run",
    "test:watch": "vitest",
    "status": "node scripts/sparo.mjs status",
    "ensure": "node scripts/sparo.mjs ensure",
    "open": "node scripts/sparo.mjs open",
    "info": "node scripts/sparo.mjs info",
    "accept": "node scripts/verify-human-shell.mjs",
    "accept:p0": "node scripts/accept-p0.mjs",
    "accept:weibo": "node scripts/accept-weibo.mjs",
