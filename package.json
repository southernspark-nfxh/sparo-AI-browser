    "accept:cs": "node scripts/accept-cs.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "electron": "^35.2.1",
    "electron-vite": "^3.1.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
